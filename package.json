{
  "name": "radio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "npm run build && wrangler dev",
    "dev:celld": "npm run build && celld dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "postinstall": "node scripts/sync-icon-font.mjs",
    "deploy:celld": "npm run build && celld deploy .",
    "start": "celld",
    "test": "npm run test:remix && npm run test:worker",
    "test:remix": "NODE_ENV=test remix test \"app/**/*.test.{ts,tsx}\" --type server --type browser",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@material-symbols/font-400": "^0.46.0",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
